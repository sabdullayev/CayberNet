# ==============================================================================
# RoninNet (Cyberpunk Samurai Messenger) - Server Configuration
# ==============================================================================

# Core Settings
PROJECT_NAME="RoninNet Cyber Core"
DEV_MODE=True
API_V1_STR="/api/v1"

# Security & JWT Tokens
SECRET_KEY="cyberpunk_ronin_super_secret_jwt_key_change_in_production_katana"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database (PostgreSQL 16)
# Default matches docker-compose.yml:
DATABASE_URL="postgresql+asyncpg://ronin_user:ronin_secret_password@localhost:5432/ronin_db"

# Redis (Realtime & OTP storage)
REDIS_URL="redis://localhost:6379/0"

# Telegram Neuromodem Bot (Aiogram 3)
# If provided, the Telegram bot runs concurrently with FastAPI in lifespan
# Leave empty if you do not want to start the bot locally
TELEGRAM_BOT_TOKEN=""

# CORS Settings (JSON list of origins or wildcard)
BACKEND_CORS_ORIGINS=["*"]
